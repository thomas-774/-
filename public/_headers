# Cloudflare Pages headers (plan §7b, §8)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-zF5D8TafX9VQkX7FeN8QeF6Z+ZljU+4reEKPSoySirg='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# HTML is revalidated so a new deploy reaches everyone
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/admin
  Cache-Control: no-cache
/admin/*
  Cache-Control: no-cache

# Content-hashed build output
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=86400
